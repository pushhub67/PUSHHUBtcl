-- ================= BALL CACHE =================
local function CheckAndAddBall(obj)
    if obj:IsA("BasePart") then
        local name = obj.Name:lower()
        if name:match("ball") or name:match("football") or name:match("bola") or obj.Name == "TPS" then
            ActiveBalls[obj] = true
        end
    end
end

for _, obj in ipairs(Workspace:GetDescendants()) do CheckAndAddBall(obj) end
Workspace.DescendantAdded:Connect(CheckAndAddBall)
Workspace.DescendantRemoving:Connect(function(obj)
    if ActiveBalls[obj] then
        ActiveBalls[obj] = nil
        if Adornments[obj] then Adornments[obj]:Destroy(); Adornments[obj] = nil end
        if BallESP[obj] then BallESP[obj].Circle:Remove(); BallESP[obj].Text:Remove(); BallESP[obj] = nil end
    end
end)

-- ================= HELPER FUNCTIONS =================
function ClearAdornments()
    for part, ad in pairs(Adornments) do if ad then ad:Destroy() end end
    table.clear(Adornments)
end

function ResetSizes()
    for part, props in pairs(OriginalProps) do
        if part and part.Parent then
            part.Size = props.Size
            part.Massless = props.Massless
            part.CanQuery = props.CanQuery
            part.CustomPhysicalProperties = props.PhysProps
        end
    end
    table.clear(OriginalProps)
end

local function ApplyVisual(part, size)
    if not State.Hitbox.ShowVisual then 
        if Adornments[part] then Adornments[part]:Destroy(); Adornments[part] = nil end
        return 
    end
    local ad = Adornments[part]
    if ad and ((State.Hitbox.Shape == "Box" and not ad:IsA("BoxHandleAdornment")) or (State.Hitbox.Shape == "Sphere" and not ad:IsA("SphereHandleAdornment"))) then
        ad:Destroy(); ad = nil
    end
    if not ad then
        ad = State.Hitbox.Shape == "Box" and Instance.new("BoxHandleAdornment") or Instance.new("SphereHandleAdornment")
        ad.Adornee = part
        ad.AlwaysOnTop = true
        ad.ZIndex = 10
        ad.Transparency = 0.5
        ad.Parent = CoreGui
        Adornments[part] = ad
    end
    
    if State.Hitbox.Shape == "Box" then ad.Size = Vector3.new(size, size, size) else ad.Radius = size / 2 end
    ad.Color3 = State.Hitbox.Color
end

local function ExpandHitbox(part, hrp, char)
    if not part then return end
    if not OriginalProps[part] then 
        OriginalProps[part] = {
            Size = part.Size, Massless = part.Massless, CanQuery = part.CanQuery, PhysProps = part.CustomPhysicalProperties
        } 
    end
    
    local desiredSize = State.Hitbox.Size

    ApplyVisual(part, desiredSize)

    part.Size = Vector3.new(desiredSize, desiredSize, desiredSize)
    part.CanCollide = false 
    part.Massless = true 
    part.CanQuery = true 
    part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
    
    if hrp and char then
        local distFromPlayer = (hrp.Position - part.Position).Magnitude
        local goibReach = math.max(desiredSize * 3, 120) 
        
        if distFromPlayer <= goibReach then 
            if firetouchinterest then
                pcall(function()
                    for _, limb in ipairs(char:GetChildren()) do
                        if limb:IsA("BasePart") then
                            firetouchinterest(limb, part, 0)
                            firetouchinterest(limb, part, 1)
                        end
                    end
                end)
            end
        end
    end
end

-- ================= ENGINE CORE LOOPS =================
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if State.Hitbox.Enabled then
        pcall(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
            sethiddenproperty(LocalPlayer, "MaxSimulationRadius", math.huge)
        end)

        if State.Hitbox.Target == "Ball" then
            for ball, _ in pairs(ActiveBalls) do
                if ball and ball.Parent then
                    ExpandHitbox(ball, hrp, char)
                end
            end
        end
    end

    for ball, _ in pairs(ActiveBalls) do
        if not BallESP[ball] then
            BallESP[ball] = { Circle = Drawing.new("Circle"), Text = Drawing.new("Text") }
            BallESP[ball].Circle.Thickness = 2
            BallESP[ball].Circle.Filled = false
            BallESP[ball].Circle.Color = Color3.fromRGB(255, 120, 0)
            BallESP[ball].Text.Center = true
            BallESP[ball].Text.Size = 14
            BallESP[ball].Text.Outline = true
            BallESP[ball].Text.Color = Color3.fromRGB(255, 255, 255)
        end

        if State.ESP.BallCircle and ball and ball.Parent then
            local pos, onScreen = Camera:WorldToViewportPoint(ball.Position)
            if onScreen then
                BallESP[ball].Circle.Visible = true
                BallESP[ball].Circle.Position = Vector2.new(pos.X, pos.Y)
                local dist = (Camera.CFrame.Position - ball.Position).Magnitude
                BallESP[ball].Circle.Radius = math.clamp(1000 / dist, 5, 100)
                
                if State.ESP.Speed then
                    BallESP[ball].Text.Visible = true
                    BallESP[ball].Text.Position = Vector2.new(pos.X, pos.Y - 18)
                    BallESP[ball].Text.Text = "Spd: " .. math.floor(ball.AssemblyLinearVelocity.Magnitude)
                else
                    BallESP[ball].Text.Visible = false
                end
            else
                BallESP[ball].Circle.Visible = false; BallESP[ball].Text.Visible = false
            end
        else
            BallESP[ball].Circle.Visible = false; BallESP[ball].Text.Visible = false
        end
    end
    
    if State.ESP.PingBox then
        pcall(function() PingText.Text = tostring(math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())) .. " ms" end)
    end
end)

